# TypeSafe Jev API key (https://docs.typesafe.ai). Without it a simple keyword/price heuristic is used.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Facebook cookies exported from a logged-in browser (Cookie-Editor JSON export works).
# Easier: paste the export in the UI under Settings -> Facebook cookies, which writes this file.
FB_COOKIES_FILE=/data/cookies.json

# Optional password for the web UI (username: admin). Leave blank to disable.
APP_PASSWORD=

# Max listing detail pages opened per search run (descriptions improve classification).
DETAIL_FETCH_LIMIT=12

# Timezone used for active hours, e.g. Australia/Sydney, Europe/London, America/New_York.
TZ=UTC
# Defaults for crawl scheduling (both editable later in the UI's Settings).
DEFAULT_INTERVAL_MINUTES=30
# Only crawl in this local-time window, e.g. 7-23 or 22-6. Empty = around the clock.
ACTIVE_HOURS=
