# TypeSafe Jev API key (https://docs.typesafe.ai). Without it a simple keyword/price heuristic is used.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Facebook cookies exported from a logged-in browser (Cookie-Editor JSON export works).
FB_COOKIES_FILE=/data/cookies.json

# Optional password for the web UI (username: admin). Leave blank to disable.
APP_PASSWORD=

# Max listing detail pages opened per search run (descriptions improve classification).
DETAIL_FETCH_LIMIT=12
